# Copy to `.env` (git-ignored). Leave DATABASE_URL empty to use the embedded
# local Postgres in .data/pglite.

# Neon connection string (Dashboard → Connect). Use the pooled host.
DATABASE_URL=

# Random string, 32+ characters: `openssl rand -hex 32`
JWT_SECRET=

# Optional – password reset emails via Resend. Without these, reset links are
# printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=

# Optional – S3-compatible photo storage (Neon Object Storage or Cloudflare R2).
# Without these, photo uploads are disabled.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional – AI photo check (Claude vision). Without it, mission photos are
# stored but never shown publicly in the community feed.
ANTHROPIC_API_KEY=
